{%- comment -%}
  LETS subscription options app block — the storefront SUBSCRIBE entry.

  The merchant drops "LETS Subscribe & Save" onto the product page in the theme
  editor and the shopper gets: one-time vs subscribe, a cadence picker, and an
  add-to-cart that carries the chosen `selling_plan`.

  This renders from Shopify's NATIVE product.selling_plan_groups — the groups our
  app publishes from the admin (Products -> a plan -> "Publish to Shopify"). That
  is deliberate and is what makes the Shopify-Payments rail work end to end:
  the cart line carries a selling_plan id, so Shopify's checkout vaults the card
  and creates a SubscriptionContract our app owns (and then bills, cycle by
  cycle, from BillingAttemptJob). No App Proxy call is needed or wanted here —
  the price, the discount and the cadence all come from Shopify itself, so the
  storefront can never be talked into a price we did not publish.

  A product with no published selling plan renders NOTHING for shoppers (and a
  short hint inside the theme editor only), so dropping the block on every
  product page is safe.

  For DEPOSIT + installments (the PayPlus rail) use the sibling block
  "LETS Deposit Plan" (blocks/installments_button.liquid) instead — that rail
  charges a PayPlus token and has its own App-Proxy-signed flow.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign groups = product.selling_plan_groups -%}
{%- assign has_plans = false -%}
{%- if groups != blank and groups.size > 0 -%}
  {%- assign has_plans = true -%}
{%- endif -%}

{%- if product and current_variant and has_plans -%}
  {%- assign first_group = groups | first -%}

  <div class="lets-subs" data-lets-subs data-variant-id="{{ current_variant.id }}">
    <form method="post" action="{{ routes.cart_add_url }}" data-lets-subs-form>
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-lets-subs-variant>

      {%- if block.settings.heading != blank -%}
        <p class="lets-subs__heading">{{ block.settings.heading }}</p>
      {%- endif -%}

      {%- comment -%} Purchase type: one-time vs subscribe. {%- endcomment -%}
      <label class="lets-subs__option">
        <input type="radio" name="lets_purchase_type" value="onetime" checked data-lets-subs-type>
        <span class="lets-subs__option-label">{{ block.settings.one_time_label | default: 'One-time purchase' }}</span>
        <span class="lets-subs__price">{{ current_variant.price | money }}</span>
      </label>

      <label class="lets-subs__option">
        <input type="radio" name="lets_purchase_type" value="subscribe" data-lets-subs-type>
        <span class="lets-subs__option-label">{{ block.settings.subscribe_label | default: 'Subscribe & save' }}</span>
      </label>

      {%- comment -%}
        Cadence. Every published plan across every group is listed; the option's
        value IS the selling_plan id Shopify expects on the cart line.
      {%- endcomment -%}
      <div class="lets-subs__plans" data-lets-subs-plans hidden>
        <select name="selling_plan" class="lets-subs__select" data-lets-subs-select aria-label="{{ first_group.name | escape }}">
          {%- for group in groups -%}
            {%- for allocation in current_variant.selling_plan_allocations -%}
              {%- if allocation.selling_plan_group_id == group.id -%}
                <option value="{{ allocation.selling_plan.id }}">
                  {{ allocation.selling_plan.name }} — {{ allocation.per_delivery_price | money }}
                </option>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </select>

        {%- if block.settings.subscribe_note != blank -%}
          <p class="lets-subs__note">{{ block.settings.subscribe_note }}</p>
        {%- endif -%}
      </div>

      <button type="submit" class="lets-subs__cta" data-lets-subs-cta>
        {{ block.settings.button_label | default: 'Add to cart' }}
      </button>
    </form>
  </div>

  {%- style -%}
    .lets-subs { margin: 12px 0; }
    .lets-subs__heading { font-size: 15px; font-weight: 600; margin: 0 0 8px; }
    .lets-subs__option {
      display: flex; align-items: center; gap: 8px; cursor: pointer;
      padding: 10px 12px; margin-bottom: 6px;
      border: 1px solid {{ block.settings.border_color | default: '#d1d5db' }};
      border-radius: 10px;
    }
    .lets-subs__option-label { flex: 1; font-size: 14px; }
    .lets-subs__price { font-size: 14px; font-weight: 600; }
    .lets-subs__plans { margin: 0 0 10px; padding-inline-start: 12px; }
    .lets-subs__select {
      width: 100%; padding: 9px 10px; font-size: 14px;
      border: 1px solid {{ block.settings.border_color | default: '#d1d5db' }};
      border-radius: 8px; background: transparent; color: inherit;
    }
    .lets-subs__note { font-size: 12px; opacity: .75; margin: 6px 0 0; }
    .lets-subs__cta {
      width: 100%; cursor: pointer; padding: 12px 16px; border-radius: 10px;
      border: 1px solid {{ block.settings.button_bg | default: '#111827' }};
      background: {{ block.settings.button_bg | default: '#111827' }};
      color: {{ block.settings.button_fg | default: '#ffffff' }};
      font-size: 15px; font-weight: 600;
    }
  {%- endstyle -%}

  <script>
    (function () {
      'use strict';
      var root = document.querySelector('[data-lets-subs]');
      if (!root || root.dataset.letsBound) { return; }
      root.dataset.letsBound = '1';

      var plans = root.querySelector('[data-lets-subs-plans]');
      var select = root.querySelector('[data-lets-subs-select]');
      var variantInput = root.querySelector('[data-lets-subs-variant]');

      function syncType() {
        var subscribing = root.querySelector('[data-lets-subs-type][value="subscribe"]').checked;
        plans.hidden = !subscribing;
        // A one-time purchase must NOT carry a selling_plan — Shopify would
        // create a subscription contract for a shopper who did not ask for one.
        select.disabled = !subscribing;
      }

      root.querySelectorAll('[data-lets-subs-type]').forEach(function (input) {
        input.addEventListener('change', syncType);
      });
      syncType();

      // Keep the posted variant in sync with the theme's variant picker, so the
      // cart line is always the variant the shopper is actually looking at.
      document.addEventListener('change', function (e) {
        var input = e.target.closest('select[name="id"], input[name="id"]');
        if (input && input.value && input !== variantInput) { variantInput.value = input.value; }
      });
      document.addEventListener('variant:change', function (e) {
        var variant = e && e.detail && e.detail.variant;
        if (variant && variant.id) { variantInput.value = variant.id; }
      });
    })();
  </script>

{%- elsif request.design_mode -%}
  {%- comment -%} Theme-editor-only hint; shoppers never see this. {%- endcomment -%}
  <p class="lets-subs__empty">
    {{ 'No subscription plan is published for this product yet. In the LETS app open Products → this product → a subscription plan → "Publish to Shopify".' }}
  </p>
{%- endif -%}

{% schema %}
{
  "name": "LETS Subscribe & Save",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Purchase options"
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One-time option label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscription option label",
      "default": "Subscribe & save"
    },
    {
      "type": "text",
      "id": "subscribe_note",
      "label": "Subscription note",
      "info": "Shown under the cadence picker.",
      "default": "Cancel or skip anytime from your account."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add-to-cart label",
      "default": "Add to cart"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "button_fg",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Option border",
      "default": "#d1d5db"
    }
  ]
}
{% endschema %}
