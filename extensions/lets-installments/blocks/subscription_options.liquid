{%- comment -%}
  LETS purchase options app block — the storefront BUY area for a product page.

  The merchant drops "LETS Subscribe & Save" onto the product page in the theme
  editor and it ALWAYS renders a working buy area, in one of two shapes:

    - the product HAS published subscription plans → a choice: one-time purchase
      vs subscribe, a cadence picker, and an add-to-cart carrying the chosen
      `selling_plan`;
    - the product has NO subscription plans → the plain one-time add-to-cart.

  So the block can be placed on every product page once and it never leaves a
  page with a dead area: publishing a plan later (LETS admin → Products → a plan
  → "Publish to Shopify") turns the same block into the choice, with no theme
  edit.

  Subscriptions render from Shopify's NATIVE selling_plan_allocations — the
  groups our app publishes. That is what makes the Shopify-Payments rail work
  end to end: the cart line carries a selling_plan id, so Shopify's checkout
  vaults the card and creates a SubscriptionContract our app owns (and then
  bills, cycle by cycle, from BillingAttemptJob). No App Proxy call is involved,
  so the storefront can never be talked into a price we did not publish.

  For DEPOSIT + installments (the PayPlus rail) use the sibling block
  "LETS Deposit Plan" (blocks/installments_button.liquid) instead — that rail
  charges a PayPlus token and has its own App-Proxy-signed flow.
{%- endcomment -%}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign allocations = current_variant.selling_plan_allocations -%}
{%- assign has_plans = false -%}
{%- if allocations != blank and allocations.size > 0 -%}
  {%- assign has_plans = true -%}
{%- endif -%}
{%- assign subscribe_first = false -%}
{%- if has_plans and block.settings.default_selection == 'subscribe' -%}
  {%- assign subscribe_first = true -%}
{%- endif -%}

{%- if product and current_variant -%}
  <div class="lets-subs" data-lets-subs data-has-plans="{{ has_plans }}">
    <form method="post" action="{{ routes.cart_add_url }}" data-lets-subs-form>
      <input type="hidden" name="form_type" value="product">
      <input type="hidden" name="utf8" value="✓">
      <input type="hidden" name="id" value="{{ current_variant.id }}" data-lets-subs-variant>

      {%- if block.settings.heading != blank -%}
        <p class="lets-subs__heading">{{ block.settings.heading }}</p>
      {%- endif -%}

      {%- if has_plans -%}
        {%- comment -%} Both options exist → let the shopper choose. {%- endcomment -%}
        <label class="lets-subs__option">
          <input type="radio" name="lets_purchase_type" value="onetime" data-lets-subs-type
            {% unless subscribe_first %}checked{% endunless %}>
          <span class="lets-subs__option-label">{{ block.settings.one_time_label | default: 'One-time purchase' }}</span>
          <span class="lets-subs__price">{{ current_variant.price | money }}</span>
        </label>

        <label class="lets-subs__option">
          <input type="radio" name="lets_purchase_type" value="subscribe" data-lets-subs-type
            {% if subscribe_first %}checked{% endif %}>
          <span class="lets-subs__option-label">{{ block.settings.subscribe_label | default: 'Subscribe & save' }}</span>
          {%- assign first_allocation = allocations | first -%}
          {%- if first_allocation.per_delivery_price < current_variant.price -%}
            <span class="lets-subs__price">{{ first_allocation.per_delivery_price | money }}</span>
          {%- endif -%}
        </label>

        {%- comment -%}
          Cadence. The option value IS the selling_plan id Shopify expects on the
          cart line, so what the shopper picks is exactly what gets billed.
        {%- endcomment -%}
        <div class="lets-subs__plans" data-lets-subs-plans {% unless subscribe_first %}hidden{% endunless %}>
          <select name="selling_plan" class="lets-subs__select" data-lets-subs-select
            aria-label="{{ block.settings.subscribe_label | default: 'Subscribe & save' | escape }}">
            {%- for allocation in allocations -%}
              <option value="{{ allocation.selling_plan.id }}">
                {{ allocation.selling_plan.name }} — {{ allocation.per_delivery_price | money }}
              </option>
            {%- endfor -%}
          </select>

          {%- if block.settings.subscribe_note != blank -%}
            <p class="lets-subs__note">{{ block.settings.subscribe_note }}</p>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- comment -%}
          No published subscription plan → a plain one-time buy area, so the block
          is safe to leave on every product page. It becomes the choice above the
          moment a plan is published; no theme edit needed.
        {%- endcomment -%}
        <div class="lets-subs__single">
          <span class="lets-subs__option-label">{{ block.settings.one_time_label | default: 'One-time purchase' }}</span>
          <span class="lets-subs__price">{{ current_variant.price | money }}</span>
        </div>
      {%- endif -%}

      <button type="submit" class="lets-subs__cta" data-lets-subs-cta {% unless current_variant.available %}disabled{% endunless %}>
        {%- if current_variant.available -%}
          {{ block.settings.button_label | default: 'Add to cart' }}
        {%- else -%}
          {{ block.settings.sold_out_label | default: 'Sold out' }}
        {%- endif -%}
      </button>

      {%- if request.design_mode and has_plans == false -%}
        {%- comment -%} Theme-editor-only hint; shoppers never see this. {%- endcomment -%}
        <p class="lets-subs__note">
          {{ 'No subscription plan is published for this product yet, so this block shows a one-time purchase. In the LETS app: Products → this product → a subscription plan → "Publish to Shopify".' }}
        </p>
      {%- endif -%}
    </form>
  </div>

  {%- style -%}
    .lets-subs { margin: 12px 0; }
    .lets-subs__heading { font-size: 15px; font-weight: 600; margin: 0 0 8px; }
    .lets-subs__option,
    .lets-subs__single {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 12px; margin-bottom: 6px;
      border: 1px solid {{ block.settings.border_color | default: '#d1d5db' }};
      border-radius: 10px;
    }
    .lets-subs__option { cursor: pointer; }
    .lets-subs__option-label { flex: 1; font-size: 14px; }
    .lets-subs__price { font-size: 14px; font-weight: 600; }
    .lets-subs__plans { margin: 0 0 10px; padding-inline-start: 12px; }
    .lets-subs__select {
      width: 100%; padding: 9px 10px; font-size: 14px;
      border: 1px solid {{ block.settings.border_color | default: '#d1d5db' }};
      border-radius: 8px; background: transparent; color: inherit;
    }
    .lets-subs__note { font-size: 12px; opacity: .75; margin: 6px 0 0; }
    .lets-subs__cta {
      width: 100%; cursor: pointer; padding: 12px 16px; border-radius: 10px;
      border: 1px solid {{ block.settings.button_bg | default: '#111827' }};
      background: {{ block.settings.button_bg | default: '#111827' }};
      color: {{ block.settings.button_fg | default: '#ffffff' }};
      font-size: 15px; font-weight: 600;
    }
    .lets-subs__cta[disabled] { opacity: .5; cursor: not-allowed; }
  {%- endstyle -%}

  <script>
    (function () {
      'use strict';
      var root = document.querySelector('[data-lets-subs]');
      if (!root || root.dataset.letsBound) { return; }
      root.dataset.letsBound = '1';

      var plans = root.querySelector('[data-lets-subs-plans]');
      var select = root.querySelector('[data-lets-subs-select]');
      var variantInput = root.querySelector('[data-lets-subs-variant]');
      var types = root.querySelectorAll('[data-lets-subs-type]');

      function syncType() {
        if (!plans || !select) { return; }
        var subscribeInput = root.querySelector('[data-lets-subs-type][value="subscribe"]');
        var subscribing = !!subscribeInput && subscribeInput.checked;
        plans.hidden = !subscribing;
        // A one-time purchase must NOT carry a selling_plan — Shopify would
        // create a subscription contract for a shopper who did not ask for one.
        select.disabled = !subscribing;
      }

      types.forEach(function (input) { input.addEventListener('change', syncType); });
      syncType();

      // Keep the posted variant in sync with the theme's variant picker, so the
      // cart line is always the variant the shopper is actually looking at.
      document.addEventListener('change', function (e) {
        var input = e.target.closest('select[name="id"], input[name="id"]');
        if (input && input.value && input !== variantInput) { variantInput.value = input.value; }
      });
      document.addEventListener('variant:change', function (e) {
        var variant = e && e.detail && e.detail.variant;
        if (variant && variant.id) { variantInput.value = variant.id; }
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "LETS Subscribe & Save",
  "target": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows a subscribe-or-buy-once choice when this product has a published subscription plan, and a plain add-to-cart when it does not — so it is safe to add to every product page. If your theme already shows its own add-to-cart, hide that one to avoid two buttons."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Purchase options"
    },
    {
      "type": "select",
      "id": "default_selection",
      "label": "Pre-selected option",
      "info": "Which option is selected when the page loads (only when a subscription plan exists).",
      "options": [
        { "value": "onetime", "label": "One-time purchase" },
        { "value": "subscribe", "label": "Subscription" }
      ],
      "default": "onetime"
    },
    {
      "type": "text",
      "id": "one_time_label",
      "label": "One-time option label",
      "default": "One-time purchase"
    },
    {
      "type": "text",
      "id": "subscribe_label",
      "label": "Subscription option label",
      "default": "Subscribe & save"
    },
    {
      "type": "text",
      "id": "subscribe_note",
      "label": "Subscription note",
      "info": "Shown under the cadence picker.",
      "default": "Cancel or skip anytime from your account."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add-to-cart label",
      "default": "Add to cart"
    },
    {
      "type": "text",
      "id": "sold_out_label",
      "label": "Sold-out label",
      "default": "Sold out"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Button background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "button_fg",
      "label": "Button text",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Option border",
      "default": "#d1d5db"
    }
  ]
}
{% endschema %}
